# Skopiuj do .env i dostosuj.

# Natywne API Ollamy
OLLAMA_HOST=http://10.67.3.153:11434
OLLAMA_MODEL=qwen3.8:27b
# Okno kontekstu przekazywane do Ollamy (domyślne 4096 jest za małe dla tego projektu).
# 65536 = tyle samo co inny agent na tym serwerze; inna wartość zmusza Ollamę do przeładowania modelu przy każdej zmianie klienta.
OLLAMA_NUM_CTX=65536
# Ile wywołań modelu może iść równolegle (Ollama i tak kolejkuje; 2 to bezpieczne minimum)
OLLAMA_CONCURRENCY=2
# Myślenie modelu (Qwen3 thinking); 1 = włączone
OLLAMA_THINK=1
# Timeout jednego wywołania modelu w sekundach
OLLAMA_TIMEOUT=900

# Rytm życia agentów
AGORA_TICK_SECONDS=20
AGORA_TICK_JITTER=10
# Maks. rund narzędziowych w jednej turze agenta
AGORA_MAX_TOOL_ROUNDS=6
# Polityka postów: strict (post musi odnosić się do węzła grafu, zawierać pytanie albo iść za operacją na grafie) lub lenient
AGORA_POST_POLICY=strict

# Web (DuckDuckGo przez ddgs, pobieranie stron, Wikipedia) – 1 włączone, 0 wyłączone
AGORA_WEB=1
AGORA_WEB_MAX_RESULTS=5
AGORA_FETCH_MAX_CHARS=5000

# Obserwacja
AGORA_SHOW_THINKING=1
# Ile znaków myślenia pokazywać w konsoli (pełna treść zawsze trafia do bazy)
AGORA_THINKING_CHARS=600
AGORA_LOG_LEVEL=INFO
# Katalog danych społeczności (SQLite, CODEX.md, cache)
AGORA_DATA_DIR=./community
# Port podglądu w przeglądarce
AGORA_VIEWER_PORT=8765
